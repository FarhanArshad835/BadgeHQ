{%- comment -%}
  Two scripts, deliberately.

  The first fetches the ranking and reorders the grid's cards before the browser
  paints them. It starts the request immediately, at the top of <head>, and the
  grid sits ~800KB further down the document - so the request is in flight for
  the whole time the parser is working through the page and the data is normally
  in hand before there is a grid to reorder.

  It asks for slim=1, which omits the neighbour lists: those are 87% of the
  payload and are not needed to order a page, only to pull in near matches,
  which happens later in widget.js. That is 10.8KB gzipped instead of 49.6KB,
  which is the difference between arriving before the paint and after it.

  Nothing is read from a cache. An earlier version stored the ranking in
  sessionStorage and reused it for the whole session, which meant a tab opened
  before the merchandising engine ran kept serving the old order - and since
  sessionStorage survives reloads, refreshing did not clear it. The ranking is
  fetched on every page load instead; the edge serves it from cache, so it costs
  a request that is already warm.

  widget.js stays async and does everything else, including the affinity
  pull-ins that need the full payload.
{%- endcomment -%}
{%- comment -%}
  Which collections the product on screen belongs to.

  Badges and bundle offers can be scoped to a collection, and the only way
  the storefront can answer "is this product in that collection?" is to
  download the collection and look. On this shop one product-page badge was
  pulling three pages of products.json - 726KB compressed, 11.5MB parsed -
  to decide whether a single product was a member.

  Liquid already knows. Emitting it here costs a few hundred bytes inline and
  removes the fetch entirely. Only rendered on a product page, where the
  product object exists.
{%- endcomment -%}
{%- if product -%}
  <script>
    window.__bhqProductCollections = {{ product.collections | map: "handle" | json }};
  </script>
{%- endif -%}
<script>
  (function () {
    var SHOP = (window.Shopify && window.Shopify.shop) || "";
    var API = "https://badgehq-widget.badgehq.workers.dev";
    try {
      var p = location.pathname;
      if (!SHOP) return;
      if (!/\/collections\//.test(p) && p !== "/") return;

      // Started now, used when the grid exists. Shared with widget.js so the
      // ranking is fetched once per page load, not twice.
      var req = fetch(API + "/api/order?slim=1&shop=" + encodeURIComponent(SHOP))
        .then(function (r) {
          return r.json();
        });
      window.__bhqRankPromise = req;

      var beh = null;
      try {
        beh = JSON.parse(sessionStorage.getItem("badgehq-behaviour") || "null");
      } catch (e) {
        beh = null;
      }
      // No engagement yet means the server order already is this shopper's
      // order, so there is nothing to reorder and nothing to wait for.
      if (!beh || !beh.b || !beh.b.length) return;

      // Default weights, matching the engine's. Deliberately not fetched: this
      // has to be ready the moment the grid is, and a shop that has retuned its
      // sliders gets the exact order from widget.js a moment later anyway.
      var W = { ca: 12, cr: -9, wa: 10, wr: -9, d: 5, v: 1 };
      var pts = {};
      for (var i = 0; i < beh.b.length; i++) {
        var b = beh.b[i];
        if (!b || !b.h) continue;
        var s = 0;
        if (b.ca) s += Math.min(b.ca * W.ca, 24);
        if (b.cr) s += b.cr * W.cr;
        if (b.wa) s += Math.min(b.wa * W.wa, 10);
        if (b.wr) s += b.wr * W.wr;
        if (b.d) s += W.d;
        if (b.v) s += Math.min(b.v * W.v, 4);
        if (s !== 0) pts[b.h] = (pts[b.h] || 0) + s;
      }

      var apply = function (rank, oos) {
        var grid = document.querySelector("#product-grid");
        if (!grid) return;
        var items = grid.children;
        if (!items || items.length < 2) return;

        var rows = [];
        for (var k = 0; k < items.length; k++) {
          var a = items[k].querySelector('a[href*="/products/"]');
          var h = "";
          if (a) {
            var m = (a.getAttribute("href") || "").match(/\/products\/([^/?#]+)/);
            if (m) h = decodeURIComponent(m[1]).toLowerCase();
          }
          var base = typeof rank[h] === "number" ? rank[h] : -(k + 1);
          if (oos[h]) base -= 100000;
          rows.push({ el: items[k], t: base + (pts[h] || 0), i: k });
        }

        rows.sort(function (x, y) {
          return y.t - x.t || x.i - y.i;
        });

        // Already right - and usually it is - so the DOM is not touched.
        var same = true;
        for (var q = 0; q < rows.length; q++) {
          if (rows[q].i !== q) {
            same = false;
            break;
          }
        }
        if (same) return;

        var frag = document.createDocumentFragment();
        for (var z = 0; z < rows.length; z++) frag.appendChild(rows[z].el);
        grid.appendChild(frag);
      };

      // Whichever is ready last: the data, or the grid being parsed.
      var ready = function (d) {
        if (!d || !d.order || !d.scores) return;
        if (d.scores.length !== d.order.length) return;
        var rank = {};
        for (var i2 = 0; i2 < d.order.length; i2++) rank[d.order[i2]] = d.scores[i2];
        var oos = {};
        var oo = d.outOfStock || [];
        for (var j = 0; j < oo.length; j++) {
          var oh = d.order[oo[j]];
          if (oh) oos[oh] = true;
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () {
            apply(rank, oos);
          });
        } else {
          apply(rank, oos);
        }
      };
      req.then(ready).catch(function () {
        /* the server order stands */
      });
    } catch (e) {
      /* any problem at all: the server order stands */
    }
  })();
</script>
<script src="https://badgehq-widget.badgehq.workers.dev/widget.js" async></script>

{% schema %}
{
  "name": "BadgeHQ Widget",
  "target": "head",
  "settings": []
}
{% endschema %}
