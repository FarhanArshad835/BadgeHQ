generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_POSTGRES_URL_NON_POOLING")
}

model Session {
  id                    String    @id
  shop                  String
  state                 String
  isOnline              Boolean   @default(false)
  scope                 String?
  expires               DateTime?
  accessToken           String?
  userId                BigInt?
  firstName             String?
  lastName              String?
  email                 String?
  accountOwner          Boolean   @default(false)
  locale                String?
  collaborator          Boolean?  @default(false)
  emailVerified         Boolean?  @default(false)
  refreshToken          String?
  refreshTokenExpires   DateTime?
}

model TrustBadge {
  id        String   @id @default(cuid())
  shop      String
  name      String   @default("Trust Badge")
  isEnabled Boolean  @default(false)
  badgeIds  String   @default("[]")
  settings  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model ProductBadge {
  id         String   @id @default(cuid())
  shop       String
  text       String   @default("Sale")
  badgeType  String   @default("text")
  shape      String   @default("rectangle")
  badgeColor String   @default("#e74c3c")
  textColor  String   @default("#ffffff")
  position   String   @default("top-left")
  placement  String   @default("image")
  targeting  String   @default("{\"type\":\"all\"}")
  isActive   Boolean  @default(false)

  // ShineTrust-level features
  condition  String   @default("{\"type\":\"none\"}")
  pages      String   @default("[\"all\"]")
  schedule   String   @default("{}")
  priority   Int      @default(0)
  imageUrl   String   @default("")
  fontSize   Int      @default(11)
  fontSizeMobile Int  @default(11)
  opacity    Float    @default(1.0)
  rotation   Int      @default(0)
  gradient   String   @default("")
  borderColor String  @default("")
  borderWidth Int     @default(0)
  customCSS  String   @default("")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop])
}

model AnnouncementBar {
  id        String   @id @default(cuid())
  shop      String
  messages  String   @default("[{\"text\":\"Welcome to our store!\",\"emoji\":\"\"}]")
  bgColor   String   @default("#000000")
  textColor String   @default("#ffffff")
  isActive  Boolean  @default(false)
  showClose Boolean  @default(true)
  pages     String   @default("[\"all\"]")
  schedule  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model FreeShippingBar {
  id        String   @id @default(cuid())
  shop      String
  threshold Float    @default(50.0)
  messages  String   @default("{\"below\":\"You're {{amount}} away from free shipping!\",\"reached\":\"Congratulations! You've earned free shipping!\"}")
  colors    String   @default("{\"barBg\":\"#f0f0f0\",\"progressBg\":\"#4caf50\",\"text\":\"#333333\"}")
  isActive  Boolean  @default(false)
  pages     String   @default("[\"cart\",\"product\"]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model StickyCart {
  id             String  @id @default(cuid())
  shop           String
  buttonText     String  @default("Add to Cart")
  buttonColor    String  @default("#ffffff")
  bgColor        String  @default("#000000")
  textColor      String  @default("#ffffff")
  buttonStyle    String  @default("solid")
  buttonRadius   String  @default("6")
  showPrice      Boolean @default(true)
  showQuantity   Boolean @default(true)
  alwaysShow     Boolean @default(false)
  showMobile     Boolean @default(true)
  showDesktop    Boolean @default(true)
  position       String  @default("bottom")
  isActive       Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shop])
}

model CountdownTimer {
  id        String   @id @default(cuid())
  shop      String
  endDate   DateTime
  style     String   @default("full")
  messages  String   @default("{\"above\":\"Hurry! Sale ends in:\",\"below\":\"Don't miss out!\"}")
  colors    String   @default("{\"bg\":\"#000000\",\"text\":\"#ffffff\",\"accent\":\"#e74c3c\"}")
  isActive  Boolean  @default(false)
  pages     String   @default("[\"product\"]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model AppSettings {
  id        String   @id @default(cuid())
  shop      String   @unique
  isEnabled Boolean  @default(true)
  settings  String   @default("{\"fontFamily\":\"inherit\",\"colorScheme\":\"light\"}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliverySettings {
  id          String   @id @default(cuid())
  shop        String   @unique
  isEnabled   Boolean  @default(false)
  apiToken    String   @default("")
  originPin   String   @default("")
  bufferDays   Int     @default(1)
  environment  String  @default("staging")
  placement    String  @default("below-atc")
  deliveryMode String  @default("standard") // "standard" | "express" | "both"
  headingText      String  @default("Estimate delivery date")
  deliverByText    String  @default("Delivery by")
  freeDeliveryOn   Boolean @default(false)
  freeDeliveryText String  @default("Free delivery")
  fasterNoteOn     Boolean @default(false)
  fasterNoteText   String  @default("Faster delivery methods available at checkout")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderManageSettings {
  id               String   @id @default(cuid())
  shop             String   @unique
  isEnabled        Boolean  @default(false)
  allowCancel      Boolean  @default(true)
  cancelScope      String   @default("unpaid") // "unpaid" | "all"
  allowAddressEdit Boolean  @default(true)
  showOnPages      String   @default("[\"account\"]") // JSON array: "account" | "account-new" | "thank-you"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WishlistSettings {
  id               String   @id @default(cuid())
  shop             String   @unique
  isEnabled        Boolean  @default(false)
  showOnCards      Boolean  @default(true)
  cardPosition     String   @default("top-right") // top-right | top-left
  showOnProduct    Boolean  @default(true)
  productPlacement String   @default("below-atc") // below-atc | above-atc
  showHeader       Boolean  @default(true)
  iconColor        String   @default("#e74c3c")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Wishlist {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  handles    String   @default("[]") // JSON array of product handles
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, customerId])
}

model BackInStockSettings {
  id          String   @id @default(cuid())
  shop        String   @unique
  isEnabled   Boolean  @default(false)
  placement   String   @default("below-atc") // below-atc | above-atc | replace-button
  buttonText  String   @default("Notify me when available")
  headingText String   @default("Get notified when this is back")
  consentText String   @default("We'll message you on WhatsApp when it's back in stock.")
  successText String   @default("Done! We'll WhatsApp you when it's back in stock.")

  // WhatsApp delivery. The shopper's number is first-party data typed into the
  // storefront form, so notifying needs no customer records and no Protected
  // Customer Data access. The merchant brings their own provider account.
  waEnabled      Boolean @default(false)
  waProvider     String  @default("interakt") // "interakt" | "doubletick"
  waApiKey       String  @default("") // provider secret; Interakt's is base64 and sent verbatim
  waTemplateName String  @default("")
  waLanguageCode String  @default("en")
  waFromNumber   String  @default("") // DoubleTick only: the sender WhatsApp number
  // Template header image. Products without a featured image fall back to this
  // so one image template covers every send (Meta rejects an empty header).
  waFallbackImage String @default("")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BackInStockSubscription {
  id         String    @id @default(cuid())
  shop       String
  variantId  String
  productId  String
  phone      String // WhatsApp number — the shopper's identity here
  notifiedAt DateTime? // set ONLY once the provider accepted the message
  createdAt  DateTime  @default(now())

  @@unique([shop, variantId, phone])
  @@index([shop, variantId])
  @@index([shop])
}

model AiReplySettings {
  id           String   @id @default(cuid())
  shop         String   @unique
  isEnabled    Boolean  @default(false)
  // "gemini" | "groq" | "claude". Groq is the practical default for new shops:
  // Gemini's free tier allows 20 requests A DAY, which no storefront can run on.
  aiProvider   String   @default("gemini")
  // Provider-specific model id. Only Claude exposes a picker today (Gemini and
  // Groq are pinned to one model each); "" means the provider's own default.
  aiModel      String   @default("")
  apiKey       String   @default("") // merchant's LLM key — server-side only
  knowledge    String   @default("") // policies/FAQ text the bot may answer from
  botName      String   @default("Support")
  greeting     String   @default("Hi! Ask me about shipping, returns or sizing.")
  supportEmail String   @default("")
  supportUrl   String   @default("")
  accentColor  String   @default("#111111")
  position     String   @default("bottom-right") // bottom-right | bottom-left

  // Inbound AI replies over WhatsApp. The same knowledge base and Gemini key
  // answer both channels; only the delivery path differs. Set independently of
  // the Back in Stock provider — a merchant may run alerts on one and chat on
  // the other.
  waReplyEnabled  Boolean @default(false)
  waProvider      String  @default("interakt") // "interakt" | "doubletick"
  waApiKey        String  @default("") // provider send key; Interakt's is base64, sent verbatim
  waWebhookSecret String  @default("") // Interakt secret_key, for HMAC verification
  // Opaque per-shop token in the webhook URL. Neither provider's payload names
  // which business number received the message, so the token is the only thing
  // identifying the shop. Uniqueness is enforced by a PARTIAL index (migration
  // 0021) because "" is the shared default.
  waWebhookToken  String  @default("")
  // DoubleTick only. Its send API requires a `from` sender number, and its
  // webhook carries NO signature — it echoes a bearer token we choose at
  // registration, so that token is what we verify instead of an HMAC.
  waFromNumber    String  @default("")
  waWebhookAuth   String  @default("")
  // Hard ceiling on AI REPLIES per UTC day (not conversations — one thread
  // commonly runs 8-20 replies, and the thread context sent with each one
  // grows as it goes, so a 20-reply thread costs ~43K tokens rather than 20x
  // a single reply). 2000 covers roughly 250 conversations a day, which is
  // headroom over normal volume while still stopping a loop or a flood from
  // draining the merchant's whole quota. 0 disables the cap.
  waDailyLimit    Int     @default(2000)

  // How much WhatsApp history to send the model with each reply. These are the
  // dominant input cost after the knowledge base, and the right value differs
  // per shop: a store with long troubleshooting threads needs more than one
  // answering quick sizing questions.
  //
  // waThreadRecent: newest messages always included.
  // waThreadOpening: messages from the START of the thread, kept because a long
  //   thread's opening usually holds the order number and the original problem
  //   while the newest messages hold only the live question.
  // waThreadLineChars / waThreadTotalChars: per-message and overall ceilings,
  //   the hard stop on what any one reply can cost.
  waThreadRecent     Int @default(20)
  waThreadOpening    Int @default(4)
  waThreadLineChars  Int @default(400)
  waThreadTotalChars Int @default(4000)

  // Debounce: how long to wait for a customer to finish a burst of messages
  // before replying once to all of them. A shopper often fires "Hi" / "where is
  // my order" / "201294" in a few seconds; this quiet gap coalesces them into a
  // single reply. Shared by WhatsApp and Instagram. 0 disables debouncing
  // (reply to each message immediately).
  waDebounceSeconds  Int @default(6)

  // Live parcel tracking. When a shopper asks "where's my order?" the bot pulls
  // the AWB out of the thread (the merchant's flow bot posts it) and asks the
  // carrier for a live status, which it feeds to the LLM. Shiprocket needs the
  // panel email + password; the Delhivery key is reused from DeliverySettings
  // (the storefront delivery-estimate feature already stores it), so there's no
  // Delhivery field here. Empty creds → that carrier is simply skipped.
  waTrackingEnabled     Boolean @default(false)
  waShiprocketEmail     String  @default("")
  waShiprocketPassword  String  @default("") // Shiprocket panel password — server-side only

  // Handoff assignment. When the bot steps back for a human, it POSTs the
  // customer's number to a DoubleTick Bot Studio flow's "On Webhook" trigger;
  // the flow's "Assign Agent" action then assigns the chat to a fixed agent.
  // This is how a chat gets assigned via automation — DoubleTick's REST API
  // can't do it, but a flow can. Empty → no assignment (silent handoff, the bot
  // just mutes itself). Paste the webhook URL from the flow's On Webhook node.
  waHandoffFlowUrl String  @default("")

  // Instagram DM replies (Meta Graph API, direct — no middleman like DoubleTick).
  // Same AI brain and knowledge base as WhatsApp; only the transport differs.
  // Instagram has no thread-scraped AWB (that comes from the merchant's WhatsApp
  // flow bot), so tracking questions are redirected to WhatsApp rather than
  // answered live. Independent of the WhatsApp settings above.
  igEnabled      Boolean @default(false)
  igPageId       String  @default("") // the Facebook Page id linked to the IG account
  igAccessToken  String  @default("") // long-lived Page access token — server-side only
  igAppSecret    String  @default("") // Meta app secret, for X-Hub-Signature-256 verification
  igWebhookToken String  @default("") // unguessable segment in our webhook URL, identifies the shop
  igVerifyToken  String  @default("") // the token Meta echoes on the GET verification challenge

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([waWebhookToken])
  @@index([igWebhookToken])
}

/// One rolling DM thread per customer on a social channel (Instagram today).
/// The channel-agnostic twin of WhatsAppConversation — customers here are keyed
/// by an opaque platform id (an Instagram-scoped user id, IGSID), not a phone,
/// so identity is (shop, channel, customerId) rather than (shop, phone). Kept
/// only long enough for the bot to follow the conversation, then purged.
model SocialConversation {
  id            String   @id @default(cuid())
  shop          String
  channel       String // "instagram" (room for "messenger" etc. later)
  customerId    String // platform user id (IGSID) — the conversation key
  turns         String   @default("[]") // JSON ChatTurn[]; capped via trimHistory()
  optedOut      Boolean  @default(false)
  mutedUntil    DateTime?
  windowCount   Int      @default(0)
  windowStart   DateTime @default(now())
  lastInboundAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, channel, customerId])
  @@index([updatedAt])
}

/// Inbound social DM awaiting an AI reply. The channel-agnostic twin of
/// WhatsAppReplyJob — Meta wants a fast webhook ack while the LLM can take 15s.
model SocialReplyJob {
  id                String   @id @default(cuid())
  shop              String
  channel           String
  customerId        String
  message           String
  providerMessageId String // Meta's message id — the idempotency key
  status            String   @default("pending") // pending | claimed | done | failed
  attempts          Int      @default(0)
  error             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, channel, providerMessageId])
  @@index([status, createdAt])
}

/// One inbound social DM the bot deliberately did NOT answer, for the same
/// "why didn't it reply" visibility as WhatsAppSkip.
model SocialSkip {
  id         String   @id @default(cuid())
  shop       String
  channel    String
  customerId String
  reason     String // muted | rate-limited | not-text | feature-off
  preview    String   @default("")
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
}

/// One rolling WhatsApp thread per shopper. Kept only long enough for the bot to
/// follow the conversation, then purged — see PURGE_AFTER_HOURS in the cron.
model WhatsAppConversation {
  id            String   @id @default(cuid())
  shop          String
  phone         String // normalised 10-digit — the conversation key
  turns         String   @default("[]") // JSON ChatTurn[]; capped via trimHistory()
  // Bot silenced for this shopper. Two sources with different lifetimes:
  //  - the shopper typed "stop"/"agent": permanent until they type "start"
  //  - the bot escalated a complaint itself: temporary, see mutedUntil
  optedOut      Boolean  @default(false)
  // When an automatic handoff mute expires. Null means permanent (an explicit
  // opt-out). Without this a single complaint silenced the bot for that number
  // forever, including for unrelated questions weeks later, because no real
  // shopper knows to type "start".
  mutedUntil    DateTime?
  windowCount   Int      @default(0) // replies sent in the current rate-limit window
  windowStart   DateTime @default(now())
  lastInboundAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, phone])
  @@index([updatedAt]) // for the purge sweep
}

/// Inbound message awaiting an AI reply. Exists because Interakt demands a 200
/// within 3s while Gemini can take 15s — the webhook records the job and a cron
/// drains it. A row is also the only durable record if a send fails.
/// One inbound message the bot deliberately did NOT answer.
///
/// These decisions happen in the webhook, before a WhatsAppReplyJob exists, so
/// without this row they leave no trace anywhere: a merchant asking "why didn't
/// it reply to this customer" had nothing to look at. Skips are far more
/// interesting than successes — they are where the feature disappoints someone.
model WhatsAppSkip {
  id        String   @id @default(cuid())
  shop      String
  phone     String
  /// muted | rate-limited | non-indian | not-text | feature-off
  reason    String
  /// First part of the message, for recognising the conversation. Truncated.
  preview   String   @default("")
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

model WhatsAppReplyJob {
  id                String   @id @default(cuid())
  shop              String
  phone             String
  message           String
  providerMessageId String // Interakt's data.message.id — the idempotency key
  status            String   @default("pending") // pending | claimed | done | failed
  attempts          Int      @default(0)
  error             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, providerMessageId]) // a redelivered webhook must not double-reply
  @@index([status, createdAt])
}

model ShopPlan {
  id        String   @id @default(cuid())
  shop      String   @unique
  plan      String   @default("free")
  billingId String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// P&L settings per shop. Carrier credentials are REUSED from AiReplySettings
/// (Shiprocket) and DeliverySettings (Delhivery) — not duplicated here. This row
/// holds only the P&L-specific config: the Meta Ads credentials (Phase 2) and
/// the last-sync bookkeeping.
model PnlSettings {
  id             String   @id @default(cuid())
  shop           String   @unique
  isEnabled      Boolean  @default(false)
  // Meta (Facebook) Ads — Phase 2. Ad spend is aggregate-only (never per-order).
  metaEnabled     Boolean @default(false)
  metaAccessToken String  @default("") // long-lived token, server-side only
  metaAdAccountId String  @default("") // "act_<id>"
  // Last sync bookkeeping, shown in the admin.
  lastSyncAt     DateTime?
  lastSyncStatus String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Per-order financials cache — the core P&L table. One row per Shopify order,
/// written on first sync and refreshed as costs bill in. Money is stored in
/// integer MINOR UNITS (paise) as BigInt — never Float/Decimal — so sums are
/// exact. A null cost means "not known yet" (Pending / cost-per-item missing),
/// NEVER zero and NEVER an estimate.
model OrderFinancials {
  id             String   @id @default(cuid())
  shop           String
  orderId        String // Shopify order gid
  orderName      String   @default("")
  orderCreatedAt DateTime
  currency       String   @default("INR")

  // Revenue side (from Shopify — always available once synced).
  grossRevenueMinor BigInt @default(0) // currentTotalPriceSet (net of order discounts)
  refundsMinor      BigInt @default(0) // totalRefundedSet
  discountsMinor    BigInt @default(0) // totalDiscountsSet (display only)

  // COGS (Shopify inventoryItem.unitCost × qty). Null = at least one sold line
  // item has no cost-per-item set, so COGS is INCOMPLETE — not zero.
  cogsMinor    BigInt?
  cogsComplete Boolean @default(false)

  // Shipping (ACTUAL billed freight from the carrier). Null = pending.
  shippingCostMinor BigInt?
  shippingStatus    String  @default("pending") // pending | billed | no-awb | unmatched | rto
  rtoCostMinor      BigInt?
  codChargeMinor    BigInt?
  awb               String  @default("")
  carrier           String  @default("") // shiprocket | delhivery | ""

  // Delivery outcome from the carrier tracking (the DELIVERED-BASIS is the whole
  // point of the monthly P&L: revenue/COGS/per-order metrics all key off orders
  // that actually delivered). Derived from tracking.server.ts's delivered/RTO
  // signals; "unknown" until the tracking backfill resolves it.
  deliveryStatus     String    @default("unknown") // delivered | rto | in_transit | no-awb | unknown
  deliveredAt        DateTime? // best-effort delivery timestamp when the carrier reports it
  deliverySyncedAt   DateTime?

  // Bookkeeping.
  financialStatus   String   @default("")
  fulfillmentStatus String   @default("")
  dataComplete      Boolean  @default(false) // cogsComplete AND shipping resolved
  // ReturnHQ EXCHANGE fee order: a genuine sale (it carries the replacement
  // product), flagged so the monthly engine can add the flat FEE portion to the
  // fee line without double-counting the product revenue already in Net Sale.
  isExchangeFee     Boolean  @default(false)
  revenueSyncedAt   DateTime?
  cogsSyncedAt      DateTime?
  shippingSyncedAt  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, orderId])
  @@index([shop, orderCreatedAt])
  @@index([shop, shippingStatus])
  @@index([shop, deliveryStatus])
  @@index([awb])
}

/// Per-line-item financials, for the per-product profitability view. Grouping by
/// productId gives contribution margin ex-shipping-ex-ad (shipping is order-level
/// and can't be split per line honestly).
model OrderLineFinancials {
  id             String   @id @default(cuid())
  shop           String
  orderId        String
  orderCreatedAt DateTime // denormalised for date-window filtering
  productId      String   @default("")
  variantId      String   @default("")
  productTitle   String   @default("")
  variantTitle   String   @default("")
  quantity       Int      @default(0)
  lineRevenueMinor BigInt @default(0)
  lineCogsMinor    BigInt?
  lineCogsComplete Boolean @default(false)
  createdAt      DateTime @default(now())

  @@index([shop, productId, orderCreatedAt])
  @@index([shop, orderId])
}

/// Standalone P&L app config (single row, id="default"). This tool lives at
/// /pnl-app — OUTSIDE the Shopify embedded app — and authenticates to Shopify
/// with a CUSTOM-APP Admin API token the brand generates in their own admin.
/// Custom apps get Protected Customer Data access automatically (no approval),
/// so this path can read orders where the embedded BadgeHQ app cannot. All
/// credentials are server-side only; the P&L data itself reuses the
/// OrderFinancials/OrderLineFinancials tables keyed by the shop domain.
model PnlApp {
  id             String   @id @default("default")
  // Access gate for the standalone tool (it's not behind Shopify login).
  passwordHash   String   @default("") // scrypt/pbkdf2 hash of the shared password
  // Shopify custom-app credentials.
  shopDomain     String   @default("") // e.g. "b03304.myshopify.com"
  adminToken     String   @default("") // shpat_… custom-app Admin API token
  // Carrier credentials (actual billed shipping — verify-first, like the app).
  shiprocketEmail    String @default("")
  shiprocketPassword String @default("")
  delhiveryApiKey    String @default("")
  // Meta Ads — direct Meta Marketing API (ads_read token), not Supermetrics.
  metaAccessToken String  @default("")
  metaAdAccountId String  @default("") // e.g. "act_908549380106884"

  // Monthly-P&L config knobs (the method's fixed rates; editable in Settings so
  // they're never hard-coded estimates the merchant can't see or change).
  // UNUSED. The Operations line was removed from the P&L: it was the only cost
  // that wasn't a real billed figure, just a Rs25/item assumption never verified
  // against actual handling costs. Column kept rather than dropped (harmless,
  // and a destructive migration for nothing) - do not wire it back in.
  opsPerPairMinor     BigInt @default(2500)
  // Stocking: a free product added to orders that still costs us to supply.
  // Counted from the delivered order lines whose product title contains
  // stockingMatch, times stockingUnitCostMinor. Blank match = feature off.
  // Flat fee charged on EVERY return/exchange request. Return-fee orders carry
  // only this amount; exchange-fee orders bundle it with the replacement product,
  // so the fee line adds this per exchange rather than the whole order total.
  returnRequestFeeMinor  BigInt @default(10000) // Rs100
  stockingMatch          String @default("")
  stockingUnitCostMinor  BigInt @default(6000) // ₹60 per stocking unit
  gstOutputRateBp     Int    @default(487)   // Output GST on delivered revenue, basis points (4.87%)
  gstInputRateNumer   Int    @default(18)    // ITC on (freight+ads+overhead): ×18/118
  gstInputRateDenom   Int    @default(118)
  maturityDays        Int    @default(12)    // wait this many days after month-end before the month is "matured"
  // First calendar month to backfill ("YYYY-MM"). The sync covers COMPLETE
  // months from here to now — NOT a rolling 90-day window (which would cut off
  // the start of older months and drift later every day). Default Apr 2026.
  backfillStartMonth  String @default("2026-04")
  // Published-to-web CSV URL of the delivery-status sheet (AWB tab). The app
  // fetches this directly (no Google auth) to set delivery outcome by AWB.
  deliverySheetUrl    String @default("")
  deliverySheetSyncedAt DateTime?
  deliverySheetStatus String @default("")

  // Resumable sync state. The nightly cron chunks a large backlog across runs:
  // it saves where it stopped (syncCursor) within a window (syncWindowStart /
  // syncWindowEnd) and resumes there next run, so no single invocation runs
  // unbounded (Vercel timeout) or keeps Neon awake longer than needed.
  syncCursor      String?   // Shopify page cursor to resume from; null = window done
  syncWindowStart DateTime? // start of the window currently being paged
  syncWindowEnd   DateTime? // end of that window
  lastSyncAt     DateTime?
  lastSyncStatus String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Per-month MANUAL inputs for the monthly P&L — the few numbers that can't be
/// pulled from an API (or that the user wants to override). One row per month.
/// Money in minor units (paise) BigInt. Null override = "use the auto value".
model PnlMonthlyInput {
  id        String @id @default(cuid())
  shop      String
  month     String // "YYYY-MM" (IST calendar month)

  // Overhead: Shopify subscription + apps + billing + Doubletick fees. A real
  // invoiced figure the merchant enters; never estimated. Kept as the combined
  // total used by the P&L math; itemized below for the statement's named rows.
  overheadMinor           BigInt @default(0)
  // Itemized fixed costs (real billed figures, entered per month). These SUM into
  // the fixed-cost total; the statement shows each as its own line.
  // One combined Shopify line (subscription + billing): the merchant enters a
  // single figure, so a separate subscription column was just a second box to
  // fill for the same cost.
  shopifyBillingMinor      BigInt @default(0)
  doubleclickFeeMinor      BigInt @default(0)
  doubleclickSubMinor      BigInt @default(0)
  // Stocking / additional inventory purchase for the month, shown alongside COGS.
  stockingMinor            BigInt @default(0)
  // Return/exchange fees collected (added back in the assembly).
  returnExchangeFeesMinor BigInt @default(0)
  // Optional overrides for values that are normally auto. Null = use auto.
  adSpendOverrideMinor    BigInt? // if the Meta pull is unavailable/wrong for a month
  freightOverrideMinor    BigInt? // if the carrier freight can't be resolved

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, month])
}

/// Computed monthly-P&L report cache (the full 8-step assembly for one month).
/// Every money field is minor units (paise) BigInt. A field is null when its
/// input is not yet known (e.g. freight pending) — NEVER estimated. `complete`
/// flags whether every cost was resolved, so the headline is trustworthy.
/// Cached ReturnHQ counts per month. Refreshed by the P&L cron (twice daily),
/// read by the dashboard so it no longer queries ReturnHQ live on every load.
model ReturnHqCache {
  id           String   @id @default(cuid())
  shop         String
  month        String // "YYYY-MM"
  returns      Int      @default(0)
  exchanges    Int      @default(0)
  // ₹ value (paise) of the orders behind those requests, for the funnel's value
  // column. Summed from OrderFinancials.grossRevenueMinor of the matched orders.
  returnsValueMinor   BigInt @default(0)
  exchangesValueMinor BigInt @default(0)
  syncedAt     DateTime @default(now())

  @@unique([shop, month])
}

model PnlMonthlyReport {
  id        String @id @default(cuid())
  shop      String
  month     String // "YYYY-MM"

  // Revenue side.
  grossSaleMinor           BigInt @default(0) // MRP × units, pre-discount
  discountsMinor           BigInt @default(0)
  netPlacedRevenueMinor    BigInt @default(0) // gross − discounts
  deliveredRevenueMinor    BigInt @default(0)
  cancelledRtoRevenueMinor BigInt @default(0) // netPlaced − delivered
  refundsMinor             BigInt @default(0)
  netSaleMinor             BigInt @default(0) // delivered − refunds

  // Counts (delivered basis).
  placedOrders    Int @default(0)
  deliveredOrders Int @default(0)
  rtoOrders       Int @default(0)
  inTransitOrders Int @default(0)
  deliveredPairs  Int @default(0) // qty sum on delivered orders

  // Costs. Null = pending / not yet known (never estimated).
  cogsMinor     BigInt? // Σ(cost-per-item × delivered qty); null if any missing
  cogsComplete  Boolean @default(false)
  freightMinor  BigInt? // deduped carrier freight; null until resolved
  freightSource String  @default("") // "auto" | "manual" | "pending"
  adSpendMinor  BigInt? // Meta month total; null until pulled
  adSpendSource String  @default("") // "meta" | "manual" | "pending"
  opsMinor      BigInt  @default(0) // ₹25 × delivered pairs
  overheadMinor BigInt  @default(0) // from PnlMonthlyInput

  // GST.
  gstOutputMinor BigInt  @default(0) // delivered revenue × output rate (backed out)
  gstInputMinor  BigInt? // (freight+ads+overhead) × 18/118; null if inputs pending
  netGstMinor    BigInt? // ITC − output

  returnExchangeFeesMinor BigInt @default(0)

  // Bottom line. Null if any required cost is still pending.
  netPnlMinor BigInt?
  complete    Boolean @default(false) // all costs resolved → headline trustworthy
  matured     Boolean @default(false) // month-end + maturityDays has passed

  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, month])
  @@index([shop, month])
}

/// Config + settings for the "Pay in USD" checkout (six-by-eleven). Single row
/// (id="default"). Razorpay International charges USD OUTSIDE Shopify checkout;
/// on payment the order is written back to Shopify. Secrets are server-side only.
model UsdCheckout {
  id                String   @id @default("default")
  enabled           Boolean  @default(false) // master on/off (also gated in theme)
  // Razorpay (test until go-live).
  razorpayKeyId     String   @default("")
  razorpayKeySecret String   @default("")
  razorpayWebhookSecret String @default("")
  // Shopify Admin token for the store we write orders into.
  shopDomain        String   @default("") // e.g. six-by-eleven.myshopify.com
  shopifyAdminToken String   @default("")
  // Pricing rule: customer pays (INR base × markupBps/10000) converted to USD.
  // markupBps 40000 = ×4 (the "Rs1000 -> Rs4000" rule).
  markupBps         Int      @default(40000)
  // Live rate cache (INR->USD), refreshed periodically so we don't hit the rate
  // API on every checkout. rate = USD per 1 INR.
  inrToUsdRate      Float    @default(0)
  rateFetchedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// One row per USD checkout attempt. Created when we make the Razorpay order (so
// we remember the cart), updated to "paid" + written back to Shopify when the
// signed payment returns. Keyed by the Razorpay order id.
model UsdOrder {
  id                String   @id @default(cuid())
  razorpayOrderId   String   @unique
  razorpayPaymentId String? // set on paid
  amountUsdCents    Int // what we charged, in USD cents
  inrToUsdRate      Float // rate used, for the record
  // Cart snapshot: JSON array of { variantId (gid), quantity, inrBasePaise, title? }.
  lineItemsJson     String   @default("[]")
  status            String   @default("created") // created | paid | shopify_written | failed
  shopifyOrderId    String? // gid of the order we wrote back
  shopifyOrderName  String? // e.g. "#1234"
  errorNote         String? // last error, if any
  // US shipping address + contact, captured before payment (inline drawer form).
  custName          String?
  custEmail         String?
  addr1             String?
  addr2             String?
  city              String?
  province          String? // US state code, e.g. "CA"
  zip               String?
  country           String?  @default("US")
  phone             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
}
